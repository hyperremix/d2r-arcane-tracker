{
  "name": "@hyperremix/d2r-arcane-tracker",
  "private": true,
  "version": "0.4.2",
  "description": "Automatic tracker for everything D2R related",
  "author": "hyperremix",
  "license": "MIT",
  "homepage": "https://hyperremix.github.io/d2r-arcane-tracker",
  "keywords": [
    "d2r",
    "diablo-2-resurrected",
    "holy-grail",
    "grail-tracker",
    "item-tracker",
    "d2r-tracker",
    "diablo-2",
    "gaming"
  ],
  "type": "module",
  "main": "dist-electron/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:debug": "node scripts/dev-with-debug.js",
    "build": "bun run typecheck && vite build && electron-builder --win",
    "db:generate": "drizzle-kit generate",
    "typecheck": "concurrently \"tsc -p tsconfig.json --noEmit\" \"tsc -p tsconfig.node.json --noEmit\"",
    "typecheck:web": "tsc -p tsconfig.json --noEmit",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky",
    "debug:url": "node scripts/get-cdp-url.js",
    "debug:update": "node scripts/update-cursor-debug.js",
    "version:major": "bun pm version major && git push --follow-tags",
    "version:minor": "bun pm version minor && git push --follow-tags",
    "version:patch": "bun pm version patch && git push --follow-tags"
  },
  "dependencies": {
    "@base-ui/react": "^1.1.0",
    "@dschu012/d2s": "https://github.com/hyperremix/d2s#9ee309c",
    "@fontsource-variable/cinzel": "^5.3.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@tanstack/react-virtual": "^3.13.12",
    "better-sqlite3": "^13.0.3",
    "chokidar": "^4.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.19",
    "dompurify": "^3.3.0",
    "drizzle-orm": "^0.45.1",
    "electron-updater": "^6.8.9",
    "i18next": "^25.4.2",
    "lucide-react": "^0.542.0",
    "pngjs": "^7.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.7.3",
    "react-router": "^7.9.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "use-debounce": "^10.0.6",
    "win32-api": "^26.1.2",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.14",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.5.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/ui": "^5.0.3",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.8",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "husky": "^9.1.7",
    "jsdom": "^27.0.0",
    "lint-staged": "^15.2.10",
    "shadcn": "^3.8.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.5",
    "tw-animate-css": "^1.3.7",
    "typescript": "^5.2.2",
    "vite": "^8.3.4",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^5.0.3"
  },
  "packageManager": "bun@1.3.8"
}
