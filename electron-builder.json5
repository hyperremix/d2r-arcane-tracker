// @see - https://www.electron.build/configuration/configuration
{
  $schema: "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  appId: "d2r-arcane-tracker",
  asar: true,
  productName: "D2R Arcane Tracker",
  directories: {
    output: "release/${version}",
  },
  // Native deps ship Node-API prebuilds (better-sqlite3 >= 13, koffi) that load in any Electron
  // version, so skip @electron/rebuild: it would otherwise invoke node-gyp, which needs a C++
  // toolchain on the build machine and cannot cross-compile.
  npmRebuild: false,
  publish: {
    provider: "github",
    owner: "hyperremix",
    repo: "d2r-arcane-tracker",
  },
  win: {
    icon: "build/logo.ico",
    target: [
      {
        target: "nsis",
        arch: ["x64"],
      },
    ],
    artifactName: "D2R-Arcane-Tracker-Windows-${version}-Setup.${ext}",
    // Each platform lists all of its `files` instead of adding to a top-level list: electron-builder
    // applies a platform list on its own, and a platform list of only `!` exclusions makes it
    // package the whole project directory (`**/*`).
    // better-sqlite3 loads prebuilds/<platform>-<arch>.node at runtime. Ship only this platform's
    // x64 prebuild (the extglob drops every other prebuild, including platforms a future version
    // adds), not the SQLite sources (deps/, src/) or a local node-gyp build/ folder.
    files: [
      "dist",
      "dist-electron",
      "!**/node_modules/better-sqlite3/{deps,src,build}/**",
      "!**/node_modules/better-sqlite3/binding.gyp",
      "!**/node_modules/better-sqlite3/prebuilds/!(win32-x64).node",
    ],
    asarUnpack: [
      "**/node_modules/better-sqlite3/**/*",
      "**/node_modules/@dschu012/**/*",
      "**/dist/logo.ico",
    ],
    // The D2RLoader plugin the app installs into the D2R folder (see docs/D2RLOADER.md). The release
    // workflow builds it into plugin/dist; a build without it ships no plugin, and the app then
    // points users to the D2RLoader hub.
    extraResources: [
      {
        from: "plugin/dist",
        to: "d2rloader",
        filter: ["d2rl-arcane-tracker.dll"],
      },
    ],
  },
  nsis: {
    oneClick: false,
    perMachine: false,
    allowToChangeInstallationDirectory: true,
    deleteAppDataOnUninstall: false,
    allowElevation: true,
  },
  linux: {
    icon: "build/logo.png",
    // The default comes from the scoped package name (`@hyperremixd2r-arcane-tracker`)
    executableName: "d2r-arcane-tracker",
    // Names the .desktop file after `desktopName` in package.json, which Electron uses as the
    // window's app ID, so desktop environments match the window to its launcher and icon
    syncDesktopName: true,
    category: "Game",
    target: [
      {
        target: "AppImage",
        arch: ["x64"],
      },
    ],
    // No version in the file name: the AppImage updater then replaces the file in place, so a
    // shortcut to it (such as a non-Steam game entry in Steam) keeps working after an update
    artifactName: "D2R-Arcane-Tracker-Linux.${ext}",
    // Same as `win.files`, with the Linux x64 prebuild
    files: [
      "dist",
      "dist-electron",
      "!**/node_modules/better-sqlite3/{deps,src,build}/**",
      "!**/node_modules/better-sqlite3/binding.gyp",
      "!**/node_modules/better-sqlite3/prebuilds/!(linux-x64).node",
    ],
    asarUnpack: ["**/node_modules/better-sqlite3/**/*", "**/node_modules/@dschu012/**/*"],
  },
  compression: "maximum",
  removePackageScripts: true,
  removePackageKeywords: true,
}
